meta {
  name: Demo with layout settings
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/templates/demo/render
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "data": {
      "title": "Office supplies",
      "reference": "DEMO-2026-001",
      "date": "2026-10-12",
      "recipient": {
        "name": "Jane Doe",
        "address": "1 Example Street\n75001 Paris",
        "email": "jane.doe@example.com"
      },
      "lines": [
        {
          "label": "Notebooks",
          "quantity": 12,
          "amount": "3.50"
        },
        {
          "label": "Desk lamp",
          "quantity": 1,
          "amount": "49.90"
        },
        {
          "label": "Printer paper, 500 sheets",
          "quantity": 5,
          "amount": "6.20"
        }
      ],
      "urgent": true,
      "status": "final",
      "note": "Delivery on Monday morning."
    },
    "metadata": {
      "title": "Demo document DEMO-2026-001",
      "author": "Example Ltd"
    },
    "layout": {
      "accentColor": "#2e7d32",
      "font": "New Computer Modern",
      "density": "compact",
      "showTotal": false
    }
  }
}

assert {
  res.status: eq 200
}

docs {
  Every `layout` setting changed, and the optional `data` properties set: `urgent`, `status: final` (no watermark) and `note`.
}
