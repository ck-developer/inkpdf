{
  "components": {
    "responses": {
      "Problem": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Error in RFC 9457 format."
      }
    },
    "schemas": {
      "Diagnostic": {
        "description": "Typst compilation diagnostic.",
        "properties": {
          "column": {
            "minimum": 0,
            "type": "integer"
          },
          "file": {
            "description": "Path relative to the template folder.",
            "type": "string"
          },
          "hints": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "line": {
            "minimum": 0,
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "DocumentMetadata": {
        "additionalProperties": false,
        "properties": {
          "author": {
            "oneOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 20,
                "minItems": 1,
                "type": "array"
              }
            ]
          },
          "date": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "type": "string"
          },
          "keywords": {
            "items": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 50,
            "type": "array"
          },
          "subject": {
            "maxLength": 2000,
            "type": "string"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "ErrorCode": {
        "description": "Machine-readable error code (FR-019).",
        "enum": [
          "template-not-found",
          "invalid-json",
          "invalid-parameter",
          "unsupported-media-type",
          "validation-failed",
          "payload-too-large",
          "template-invalid",
          "render-failed",
          "render-timeout",
          "overloaded"
        ],
        "type": "string"
      },
      "Health": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "templates": {
            "description": "Number of valid templates.",
            "minimum": 0,
            "type": "integer"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "templates",
          "version"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok",
          "starting"
        ],
        "type": "string"
      },
      "PackageInfo": {
        "description": "Package a template can import.",
        "properties": {
          "description": {
            "type": "string"
          },
          "import": {
            "description": "Import line to write in a template (never with a version).",
            "example": "@preview/zero",
            "type": "string"
          },
          "license": {
            "description": "SPDX identifier or expression.",
            "example": "MIT",
            "type": "string"
          },
          "name": {
            "description": "Package name on Typst Universe.",
            "example": "zero",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "version": {
            "description": "Version installed in the service (informational only).",
            "example": "0.7.1",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "import",
          "version",
          "description",
          "license"
        ],
        "type": "object"
      },
      "PackageList": {
        "properties": {
          "packages": {
            "description": "Sorted by name; one entry per package.",
            "items": {
              "$ref": "#/components/schemas/PackageInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "packages"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 error body.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "type": "string"
          },
          "diagnostics": {
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            },
            "type": "array"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "templateId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          },
          "violations": {
            "items": {
              "$ref": "#/components/schemas/Violation"
            },
            "type": "array"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      },
      "RenderRequest": {
        "additionalProperties": false,
        "description": "Generic shape; the exact shape of `data` and `layout` is given by the template's schema\n(`GET /templates/{templateId}/schema`).",
        "properties": {
          "data": {
            "additionalProperties": {},
            "description": "Business data.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "layout": {
            "additionalProperties": {},
            "description": "Layout parameters; missing properties take their `default`.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "metadata": {
            "$ref": "#/components/schemas/DocumentMetadata",
            "description": "PDF metadata, all optional. Without `author`, the service's default author\n(`INKPDF_DEFAULT_AUTHOR`, `inkpdf` by default); without `title`, the template's title,\nor failing that its name. `date` in `YYYY-MM-DD` format."
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "TemplateDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TemplateSummary"
          },
          {
            "properties": {
              "links": {
                "$ref": "#/components/schemas/TemplateLinks"
              },
              "loadedAt": {
                "format": "date-time",
                "type": "string"
              },
              "schema": {
                "description": "Input JSON Schema (absent when the template is invalid).",
                "type": "object"
              }
            },
            "required": [
              "loadedAt",
              "links"
            ],
            "type": "object"
          }
        ]
      },
      "TemplateLinks": {
        "properties": {
          "render": {
            "example": "/templates/sample/render",
            "type": "string"
          },
          "schema": {
            "example": "/templates/sample/schema",
            "type": "string"
          }
        },
        "required": [
          "schema",
          "render"
        ],
        "type": "object"
      },
      "TemplateList": {
        "properties": {
          "templates": {
            "items": {
              "$ref": "#/components/schemas/TemplateSummary"
            },
            "type": "array"
          }
        },
        "required": [
          "templates"
        ],
        "type": "object"
      },
      "TemplateStatus": {
        "enum": [
          "valid",
          "invalid"
        ],
        "type": "string"
      },
      "TemplateSummary": {
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "reason": {
            "description": "Present when `status` is `invalid`.",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TemplateStatus"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status"
        ],
        "type": "object"
      },
      "Violation": {
        "description": "A request body's violation of a template's schema.",
        "properties": {
          "message": {
            "type": "string"
          },
          "path": {
            "description": "JSON Pointer into the request body.",
            "type": "string"
          },
          "schemaPath": {
            "description": "JSON Pointer into the schema.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "schemaPath",
          "message"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Internal service (private VPC, no authentication). Templates are hot-loaded from a mounted volume; the caller sends only JSON (`data` + `layout`), validated against the template's JSON Schema before generation.",
    "license": {
      "identifier": "MIT OR Apache-2.0",
      "name": "MIT OR Apache-2.0"
    },
    "title": "inkpdf",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The process responds."
          }
        },
        "summary": "Process liveness",
        "tags": [
          "ops"
        ]
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "OpenAPI 3.1 document."
          }
        },
        "summary": "This document, in JSON format",
        "tags": [
          "ops"
        ]
      }
    },
    "/packages": {
      "get": {
        "description": "Packages present only as dependencies of other packages are not listed: they\ncannot be imported.",
        "operationId": "listPackages",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageList"
                }
              }
            },
            "description": "Packages importable with `#import \"@preview/<name>\"`."
          }
        },
        "summary": "Packages available to templates",
        "tags": [
          "packages"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Ready."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Initial scan in progress."
          }
        },
        "summary": "Readiness (initial volume scan finished)",
        "tags": [
          "ops"
        ]
      }
    },
    "/templates": {
      "get": {
        "operationId": "listTemplates",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateList"
                }
              }
            },
            "description": "Known templates, valid or invalid, sorted by identifier."
          }
        },
        "summary": "List the templates in the volume",
        "tags": [
          "templates"
        ]
      }
    },
    "/templates/{templateId}": {
      "get": {
        "operationId": "getTemplate",
        "parameters": [
          {
            "description": "Template identifier (its folder name).",
            "example": "sample",
            "in": "path",
            "name": "templateId",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateDetail"
                }
              }
            },
            "description": "Template detail."
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Template detail, schema included",
        "tags": [
          "templates"
        ]
      }
    },
    "/templates/{templateId}/render": {
      "post": {
        "description": "Validates the body against the template's schema (after applying the `default` values of\n`layout`), then returns the PDF. No generation is attempted if validation fails.",
        "operationId": "renderTemplate",
        "parameters": [
          {
            "description": "Template identifier (its folder name).",
            "example": "sample",
            "in": "path",
            "name": "templateId",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            }
          },
          {
            "description": "`true`: respond as a download (`Content-Disposition: attachment`) instead of\ninline display. Values: `true`, `false`, `1`, `0`.",
            "in": "query",
            "name": "download",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "description": "File name (no path; `.pdf` appended). Default: `<templateId>.pdf`.",
            "in": "query",
            "name": "filename",
            "required": false,
            "schema": {
              "maxLength": 200,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/pdf": {
                "schema": {
                  "contentMediaType": "application/pdf",
                  "type": "string"
                }
              }
            },
            "description": "Generated document.",
            "headers": {
              "Content-Disposition": {
                "description": "`inline` (display) or `attachment` (download, `download=true`), with `filename` and `filename*` (UTF-8).",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Body does not match the template's schema."
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          },
          "504": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Generate a PDF",
        "tags": [
          "render"
        ]
      }
    },
    "/templates/{templateId}/schema": {
      "get": {
        "description": "Usable directly by a validator or a form generator.",
        "operationId": "getTemplateSchema",
        "parameters": [
          {
            "description": "Template identifier (its folder name).",
            "example": "sample",
            "in": "path",
            "name": "templateId",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/schema+json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "JSON Schema (draft 2020-12)."
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Raw JSON Schema of the template input",
        "tags": [
          "templates"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "templates"
    },
    {
      "name": "render"
    },
    {
      "name": "packages"
    },
    {
      "name": "ops"
    }
  ]
}
