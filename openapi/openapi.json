{
  "components": {
    "responses": {
      "Problem": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Erreur au format RFC 9457."
      }
    },
    "schemas": {
      "Diagnostic": {
        "description": "Diagnostic de compilation Typst.",
        "properties": {
          "column": {
            "minimum": 0,
            "type": "integer"
          },
          "file": {
            "description": "Chemin relatif au dossier du template.",
            "type": "string"
          },
          "hints": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "line": {
            "minimum": 0,
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "Code machine d'une erreur (FR-019).",
        "enum": [
          "template-not-found",
          "invalid-json",
          "unsupported-media-type",
          "validation-failed",
          "payload-too-large",
          "template-invalid",
          "render-failed",
          "render-timeout",
          "overloaded"
        ],
        "type": "string"
      },
      "Health": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "templates": {
            "description": "Nombre de templates valides.",
            "minimum": 0,
            "type": "integer"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "templates",
          "version"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok",
          "starting"
        ],
        "type": "string"
      },
      "Problem": {
        "description": "Corps d'erreur RFC 9457.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "type": "string"
          },
          "diagnostics": {
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            },
            "type": "array"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "templateId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          },
          "violations": {
            "items": {
              "$ref": "#/components/schemas/Violation"
            },
            "type": "array"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      },
      "RenderRequest": {
        "additionalProperties": false,
        "description": "Forme générique ; la forme exacte de `data` et `design` est donnée par le schéma du template\n(`GET /templates/{templateId}/schema`).",
        "properties": {
          "data": {
            "additionalProperties": {},
            "description": "Données métier.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "design": {
            "additionalProperties": {},
            "description": "Paramètres de design ; les propriétés absentes prennent leur `default`.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "TemplateDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TemplateSummary"
          },
          {
            "properties": {
              "links": {
                "$ref": "#/components/schemas/TemplateLinks"
              },
              "loadedAt": {
                "format": "date-time",
                "type": "string"
              },
              "schema": {
                "description": "JSON Schema de l'entrée (absent si le template est invalide).",
                "type": "object"
              }
            },
            "required": [
              "loadedAt",
              "links"
            ],
            "type": "object"
          }
        ]
      },
      "TemplateLinks": {
        "properties": {
          "render": {
            "example": "/templates/sample/render",
            "type": "string"
          },
          "schema": {
            "example": "/templates/sample/schema",
            "type": "string"
          }
        },
        "required": [
          "schema",
          "render"
        ],
        "type": "object"
      },
      "TemplateList": {
        "properties": {
          "templates": {
            "items": {
              "$ref": "#/components/schemas/TemplateSummary"
            },
            "type": "array"
          }
        },
        "required": [
          "templates"
        ],
        "type": "object"
      },
      "TemplateStatus": {
        "enum": [
          "valid",
          "invalid"
        ],
        "type": "string"
      },
      "TemplateSummary": {
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "reason": {
            "description": "Présent si `status` vaut `invalid`.",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TemplateStatus"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status"
        ],
        "type": "object"
      },
      "Violation": {
        "description": "Violation du schéma d'un template par le corps d'une requête.",
        "properties": {
          "message": {
            "type": "string"
          },
          "path": {
            "description": "JSON Pointer dans le corps de la requête.",
            "type": "string"
          },
          "schemaPath": {
            "description": "JSON Pointer dans le schéma.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "schemaPath",
          "message"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Service interne (VPC privé, sans authentification). Les templates sont lus à chaud depuis un volume monté ; l'appelant n'envoie que du JSON (`data` + `design`), validé contre le JSON Schema du template avant génération.",
    "license": {
      "name": "TODO(LICENSE) — MIT OR Apache-2.0 proposé"
    },
    "title": "inkpdf",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Le processus répond."
          }
        },
        "summary": "Vivacité du processus",
        "tags": [
          "ops"
        ]
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Document OpenAPI 3.1."
          }
        },
        "summary": "Ce document, au format JSON",
        "tags": [
          "ops"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Prêt."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Scan initial en cours."
          }
        },
        "summary": "Disponibilité (scan initial du volume terminé)",
        "tags": [
          "ops"
        ]
      }
    },
    "/templates": {
      "get": {
        "operationId": "listTemplates",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateList"
                }
              }
            },
            "description": "Templates connus, valides ou invalides, triés par identifiant."
          }
        },
        "summary": "Lister les templates du volume",
        "tags": [
          "templates"
        ]
      }
    },
    "/templates/{templateId}": {
      "get": {
        "operationId": "getTemplate",
        "parameters": [
          {
            "description": "Identifiant du template (nom de son dossier).",
            "example": "sample",
            "in": "path",
            "name": "templateId",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateDetail"
                }
              }
            },
            "description": "Détail du template."
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Détail d'un template, schéma compris",
        "tags": [
          "templates"
        ]
      }
    },
    "/templates/{templateId}/render": {
      "post": {
        "description": "Valide le corps contre le schéma du template (après application des valeurs `default` de\n`design`), puis renvoie le PDF. Aucune génération n'est tentée si la validation échoue.",
        "operationId": "renderTemplate",
        "parameters": [
          {
            "description": "Identifiant du template (nom de son dossier).",
            "example": "sample",
            "in": "path",
            "name": "templateId",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/pdf": {
                "schema": {
                  "contentMediaType": "application/pdf",
                  "type": "string"
                }
              }
            },
            "description": "Document généré.",
            "headers": {
              "Content-Disposition": {
                "description": "inline; filename=\"<templateId>.pdf\"",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Corps non conforme au schéma du template."
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          },
          "504": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Générer un PDF",
        "tags": [
          "render"
        ]
      }
    },
    "/templates/{templateId}/schema": {
      "get": {
        "description": "Utilisable directement par un validateur ou un générateur de formulaires.",
        "operationId": "getTemplateSchema",
        "parameters": [
          {
            "description": "Identifiant du template (nom de son dossier).",
            "example": "sample",
            "in": "path",
            "name": "templateId",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/schema+json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "JSON Schema (draft 2020-12)."
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "JSON Schema brut de l'entrée du template",
        "tags": [
          "templates"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "templates"
    },
    {
      "name": "render"
    },
    {
      "name": "ops"
    }
  ]
}
